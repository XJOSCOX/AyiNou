{
  "name": "ayinou",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @ayinou/api\" \"npm run dev -w @ayinou/web\"",
    "dev:api": "npm run dev -w @ayinou/api",
    "dev:web": "npm run dev -w @ayinou/web",
    "db:migrations": "supabase migration list --remote",
    "db:push:dry": "supabase db push --remote --skip-vault --dry-run",
    "db:push": "supabase db push --remote --skip-vault",
    "db:local:start": "supabase start",
    "db:local:stop": "supabase stop",
    "db:local:reset": "supabase db reset",
    "db:local:test": "supabase test db",
    "db:cleanup:post-media": "node --import tsx scripts/cleanup-post-media.mjs",
    "db:cleanup:safety": "node --import tsx scripts/cleanup-safety.mjs",
    "test:hosted": "node --import tsx scripts/check-hosted.mjs",
    "test:hosted:aggregation": "node --import tsx scripts/check-phase2-aggregation.mjs",
    "test:hosted:accounts": "node --import tsx scripts/check-phase2c-hosted.mjs",
    "test:hosted:accounts:preflight": "node scripts/check-phase2c-migration.mjs",
    "test:hosted:institutions:sql": "node scripts/check-phase2d-sql.mjs",
    "test:hosted:institutions": "node --import tsx scripts/check-phase2d-hosted.mjs",
    "test:hosted:organization-roles:sql": "node scripts/check-organization-roles-sql.mjs",
    "test:hosted:organization-roles": "node --import tsx scripts/check-phase2d-hosted.mjs --roles",
    "test:hosted:projects:sql": "node scripts/check-projects-sql.mjs",
    "test:hosted:project-work:sql": "node scripts/check-project-work-sql.mjs",
    "test:hosted:project-progress:sql": "node scripts/check-project-progress-sql.mjs",
    "test:hosted:polls:sql": "node scripts/check-polls-sql.mjs",
    "test:hosted:polls": "node --import tsx scripts/check-polls-hosted.mjs",
    "test:hosted:projects": "node --import tsx scripts/check-projects-hosted.mjs",
    "test:hosted:affiliations:sql": "node scripts/check-affiliations-sql.mjs",
    "test:hosted:admin:sql": "node scripts/check-admin-sql.mjs",
    "test:hosted:admin": "node --import tsx scripts/check-admin-hosted.mjs",
    "test:hosted:feed:sql": "node scripts/check-feed-sql.mjs",
    "test:hosted:following:sql": "node scripts/check-following-sql.mjs",
    "test:hosted:following": "node --import tsx scripts/check-following-hosted.mjs",
    "test:hosted:recommendations:sql": "node scripts/check-recommendations-sql.mjs",
    "test:hosted:recommendations": "node --import tsx scripts/check-recommendations-hosted.mjs",
    "test:hosted:engagement:sql": "node scripts/check-engagement-sql.mjs",
    "test:hosted:media:sql": "node scripts/check-media-notifications-sql.mjs",
    "test:hosted:media": "node --import tsx scripts/check-media-notifications-hosted.mjs",
    "test:hosted:safety:sql": "node scripts/check-safety-sql.mjs",
    "test:hosted:safety": "node --import tsx scripts/check-safety-hosted.mjs",
    "test:hosted:departments:sql": "node scripts/check-department-communities-sql.mjs",
    "test:hosted:departments": "node --import tsx scripts/check-department-communities-hosted.mjs",
    "test:hosted:groups:sql": "node scripts/check-member-groups-sql.mjs",
    "test:hosted:groups": "node --import tsx scripts/check-member-groups-hosted.mjs",
    "test:hosted:community-recommendations:sql": "node scripts/check-community-recommendations-sql.mjs",
    "test:hosted:community-recommendations": "node --import tsx scripts/check-community-recommendations-hosted.mjs",
    "test:hosted:trust:sql": "node scripts/check-verification-trust-sql.mjs",
    "test:hosted:ambassadors:sql": "node scripts/check-ambassadors-sql.mjs",
    "test:hosted:ambassadors": "node --import tsx scripts/check-verification-trust-hosted.mjs --ambassadors",
    "test:hosted:trust": "node --import tsx scripts/check-verification-trust-hosted.mjs",
    "test:hosted:feed": "node --import tsx scripts/check-feed-hosted.mjs",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "test:shared": "node --import tsx scripts/check-shared-contracts.mjs",
    "test:i18n": "node scripts/check-translations.mjs",
    "test:client-errors": "node --import tsx --test scripts/check-client-errors.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:smoke": "node scripts/run-e2e.mjs --grep @smoke",
    "test:e2e:headed": "node scripts/run-e2e.mjs --headed",
    "test": "npm run test:shared && npm run test:i18n && npm run test:client-errors && npm run test -ws --if-present",
    "build": "npm run build -w @ayinou/api && npm run build -w @ayinou/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "supabase": "3.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
