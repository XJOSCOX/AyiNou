{
  "name": "ayinou",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @ayinou/api\" \"npm run dev -w @ayinou/web\"",
    "dev:api": "npm run dev -w @ayinou/api",
    "dev:web": "npm run dev -w @ayinou/web",
    "db:migrations": "supabase migration list --remote",
    "db:push:dry": "supabase db push --remote --skip-vault --dry-run",
    "db:push": "supabase db push --remote --skip-vault",
    "db:local:start": "supabase start",
    "db:local:stop": "supabase stop",
    "db:local:reset": "supabase db reset",
    "db:local:test": "supabase test db",
    "test:hosted": "node --import tsx scripts/check-hosted.mjs",
    "test:hosted:aggregation": "node --import tsx scripts/check-phase2-aggregation.mjs",
    "test:hosted:accounts": "node --import tsx scripts/check-phase2c-hosted.mjs",
    "test:hosted:accounts:preflight": "node scripts/check-phase2c-migration.mjs",
    "test:hosted:institutions:sql": "node scripts/check-phase2d-sql.mjs",
    "test:hosted:institutions": "node --import tsx scripts/check-phase2d-hosted.mjs",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "test": "npm run test -ws --if-present",
    "build": "npm run build -w @ayinou/api && npm run build -w @ayinou/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "supabase": "3.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
