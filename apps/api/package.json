{
  "name": "@ayinou/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsup src/server.ts --format esm --platform node --target node20 --out-dir dist --clean"
  },
  "dependencies": {"@ayinou/shared": "*", "@fastify/cors": "^11.0.0", "dotenv": "^16.6.1", "fastify": "^5.6.0", "zod": "^4.1.0"},
  "devDependencies": {"@types/node": "^22.18.0", "eslint": "^9.35.0", "typescript-eslint": "^8.44.0", "tsx": "^4.20.0", "tsup": "^8.5.0"}
}
