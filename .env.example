# Hosted Supabase development: copy the API values to apps/api/.env and the
# web values to apps/web/.env.local. These files are ignored by Git.
# Project URL and publishable key: Supabase Dashboard > Connect / API Keys.
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
WEB_ORIGIN=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-hosted-publishable-key
# The following belong ONLY in apps/api/.env. Never prefix the secret NEXT_PUBLIC_:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-hosted-publishable-key
SUPABASE_SECRET_KEY=replace-with-hosted-secret-key
# Optional, server-only. Set to the exact UUID of the first real account after
# email confirmation and TOTP setup. It runs once per database at API startup.
# Enable only during controlled Founder enrollment. Provide email and username to the private operator command.
# AYINOU_FOUNDER_BOOTSTRAP_ENABLED=false
# AYINOU_FOUNDER_EMAIL=
# AYINOU_FOUNDER_USERNAME=

# Privacy request processing is disabled. The synthetic mode is reserved for disposable tests.
AYINOU_PRIVACY_INTAKE=disabled
AYINOU_PRIVACY_EXPORT=disabled
AYINOU_PRIVACY_LIFECYCLE=disabled
