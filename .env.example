# Use apps/api/.env for server settings and apps/web/.env.local for browser settings.
# Obtain local values from `npx supabase status -o json` after `npm run db:start`.
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGINS=http://127.0.0.1:4000,http://localhost:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
WEB_ORIGIN=http://127.0.0.1:4000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# The following variables belong ONLY in apps/api/.env. Never prefix them NEXT_PUBLIC_:
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
DATABASE_URL=replace-with-local-db-url
